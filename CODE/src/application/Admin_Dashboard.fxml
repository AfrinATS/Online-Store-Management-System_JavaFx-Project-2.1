<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="607.0" prefWidth="675.0" style="-fx-background-color: linear-gradient(to bottom right, #FFA500, #32CD32);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.adminController">
    
    <StackPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <!-- Main Content -->
        <AnchorPane>
            <Label layoutX="166.0" layoutY="79.0" text="Admin Menu" textFill="WHITE">
                <font>
                    <Font size="60.0" />
                </font>
                <effect>
                    <DropShadow color="rgba(0,0,0,0.3)" offsetX="2" offsetY="2" radius="5" />
                </effect>
            </Label>
            
            <Button fx:id="viewAllProducts" layoutX="56.0" layoutY="193.0" mnemonicParsing="false" onAction="#viewProducts" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #FF8C00, #FFD700);                            -fx-background-radius: 25px;                            -fx-border-radius: 25px;                            -fx-border-width: 2px;                            -fx-border-color: rgba(255,255,255,0.8);                            -fx-cursor: hand;                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="View List of Products" textFill="WHITE">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
            
            <Button layoutX="56.0" layoutY="268.0" mnemonicParsing="false" onAction="#addNewProduct" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #32CD32, #ADFF2F);                            -fx-background-radius: 25px;                            -fx-border-radius: 25px;                            -fx-border-width: 2px;                            -fx-border-color: rgba(255,255,255,0.8);                            -fx-cursor: hand;                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Add Item to Store" textFill="WHITE">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
            
            <Button fx:id="putItemOnSale" layoutX="56.0" layoutY="349.0" mnemonicParsing="false" onAction="#handleSale" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #FF6347, #FFA07A);                            -fx-background-radius: 25px;                            -fx-border-radius: 25px;                            -fx-border-width: 2px;                            -fx-border-color: rgba(255,255,255,0.8);                            -fx-cursor: hand;                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Put item on sale" textFill="WHITE">
                <font>
                    <Font size="20.0" />
                </font>
            </Button>
            
            <Button layoutX="75.0" layoutY="486.0" mnemonicParsing="false" onAction="#backToWelcome" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: rgba(255,255,255,0.3);                            -fx-background-radius: 20px;                            -fx-border-radius: 20px;                            -fx-border-width: 1px;                            -fx-border-color: white;                            -fx-cursor: hand;" text="Back" textFill="WHITE">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>
           
           <!-- Exit Button -->
           <Button layoutX="589.0" layoutY="496.0" mnemonicParsing="false" onAction="#handleExit" style="-fx-background-color: rgba(255,69,0,0.7);                        -fx-background-radius: 15px;                        -fx-border-radius: 15px;                        -fx-border-width: 1px;                        -fx-border-color: rgba(255,255,255,0.5);                        -fx-cursor: hand;                        -fx-font-weight: bold;                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 1);" text="X" textFill="WHITE">
               <font>
                   <Font size="18.0" />
               </font>
               <padding>
                   <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
               </padding>
           </Button>
        </AnchorPane>
    </StackPane>
</AnchorPane>
