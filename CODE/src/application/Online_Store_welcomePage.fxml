<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: linear-gradient(to bottom right, #FFA500, #32CD32);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.welcome_controller">
   
   <StackPane VBox.vgrow="ALWAYS">
      <VBox alignment="CENTER" spacing="20.0">
         <!-- Welcome Text with Enhanced Effects -->
         <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome" textAlignment="CENTER" wrappingWidth="300.0">
            <font>
               <Font name="System Bold" size="60.0" />
            </font>
            <effect>
               <DropShadow color="rgba(0,0,0,0.3)" offsetX="3" offsetY="3" radius="10" />
            </effect>
         </Text>
         
         <!-- Admin Button with Citrus Style -->
         <Button fx:id="adminButton" alignment="CENTER" onAction="#handleAdmin" prefHeight="55.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #FF8C00, #FFD700);                         -fx-background-radius: 30px;                         -fx-border-radius: 30px;                         -fx-border-width: 2px;                         -fx-border-color: rgba(255,255,255,0.8);                         -fx-cursor: hand;                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);" text="Login As Admin" textFill="WHITE">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <VBox.margin>
               <Insets top="15.0" />
            </VBox.margin>
            <effect>
               <InnerShadow choke="0.5" color="rgba(0,0,0,0.1)" radius="5" />
            </effect>
         </Button>
         
         <!-- Customer Button with Fresh Style -->
         <Button fx:id="customerButton" alignment="CENTER" onAction="#handleCustomer" prefHeight="56.0" prefWidth="277.0" style="-fx-background-color: linear-gradient(to right, #32CD32, #ADFF2F);                         -fx-background-radius: 30px;                         -fx-border-radius: 30px;                         -fx-border-width: 2px;                         -fx-border-color: rgba(255,255,255,0.8);                         -fx-cursor: hand;                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);" text="Login As Customer" textFill="WHITE">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <VBox.margin>
               <Insets bottom="25.0" top="15.0" />
            </VBox.margin>
            <effect>
               <InnerShadow choke="0.5" color="rgba(0,0,0,0.1)" radius="5" />
            </effect>
         </Button>
      </VBox>
      
      <!-- Exit Button in Bottom Right Corner -->
      <Button fx:id="exitButton" alignment="BOTTOM_RIGHT" onAction="#handleExit" style="-fx-background-color: rgba(255,69,0,0.7);                      -fx-background-radius: 15px;                      -fx-border-radius: 15px;                      -fx-border-width: 1px;                      -fx-border-color: rgba(255,255,255,0.5);                      -fx-cursor: hand;                      -fx-font-weight: bold;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 1);" text="X" textFill="WHITE" StackPane.alignment="BOTTOM_RIGHT">
         <font>
            <Font size="18.0" />
         </font>
         <padding>
            <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
         </padding>
         <StackPane.margin>
            <Insets bottom="20.0" right="20.0" />
         </StackPane.margin>
      </Button>
   </StackPane>
   
   <cursor>
      <Cursor fx:constant="DEFAULT" />
   </cursor>
</VBox>
