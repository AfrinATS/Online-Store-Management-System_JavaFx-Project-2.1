<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="526.0" prefWidth="662.0" style="-fx-background-color: linear-gradient(to bottom right, #FFA500, #32CD32);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.customerDashboardController">
    <Label layoutX="105.0" layoutY="47.0" text="Customer Menu" textFill="WHITE">
        <font>
            <Font name="System Bold" size="60.0" />
        </font>
    </Label>
    <Button fx:id="viewProductButton" layoutX="218.0" layoutY="195.0" mnemonicParsing="false" onAction="#viewProducts" prefHeight="40.0" prefWidth="211.0" style="-fx-background-color: #ffffff; -fx-text-fill: #FF8C00; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-width: 2; -fx-border-color: #FF8C00; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="View All Product" />
    <Button layoutX="218.0" layoutY="280.0" mnemonicParsing="false" onAction="#purchaseProduct" prefHeight="40.0" prefWidth="211.0" style="-fx-background-color: #ffffff; -fx-text-fill: #228B22; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-width: 2; -fx-border-color: #228B22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Buy Product" />
    <Button layoutX="60.0" layoutY="439.0" mnemonicParsing="false" onAction="#backToWelcome" prefHeight="39.0" prefWidth="80.0" style="-fx-background-color: #ffffff; -fx-text-fill: #4169E1; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-width: 2; -fx-border-color: #4169E1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Back" />
</AnchorPane>
