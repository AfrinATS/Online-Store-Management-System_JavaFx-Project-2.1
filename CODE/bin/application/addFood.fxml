<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/23.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.addFoodController">
   
   <!-- Orange-Green Gradient Background -->
   <Rectangle width="650.0" height="550.0">
      <fill>
         <LinearGradient startX="0" startY="0" endX="1" endY="1">
            <stops>
               <Stop offset="0.0" color="#FFA500"/> <!-- Orange -->
               <Stop offset="1.0" color="#32CD32"/> <!-- Green -->
            </stops>
         </LinearGradient>
      </fill>
   </Rectangle>
   
   <!-- Title -->
   <Text fill="WHITE" layoutX="200.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Add New Food" style="-fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0, 0, 1);">
      <font>
         <Font size="30.0" />
      </font>
   </Text>
   
   <!-- Form Labels (Left-Aligned) -->
   <Text fill="WHITE" layoutX="100.0" layoutY="150.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="ID:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="100.0" layoutY="190.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Name:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="100.0" layoutY="230.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Price:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="100.0" layoutY="270.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Quantity:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="100.0" layoutY="310.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Manufacturing Date:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="100.0" layoutY="350.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Expiration Date:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   
   <!-- Rounded Text Fields -->
   <TextField fx:id="idField" layoutX="300.0" layoutY="130.0" prefWidth="300.0" 
              style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
   <TextField fx:id="nameField" layoutX="300.0" layoutY="170.0" prefWidth="300.0" 
              style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
   <TextField fx:id="priceField" layoutX="300.0" layoutY="210.0" prefWidth="300.0" 
              style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
   <TextField fx:id="quantityField" layoutX="300.0" layoutY="250.0" prefWidth="300.0" 
              style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
   <TextField fx:id="manufacturingField" layoutX="300.0" layoutY="290.0" prefWidth="300.0" 
              style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
   <TextField fx:id="expiryField" layoutX="300.0" layoutY="330.0" prefWidth="300.0" 
              style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>
              <!-- Add this TextField below the expiryField -->
<TextField fx:id="onSaleField" layoutX="300.0" layoutY="370.0" prefWidth="300.0" 
          promptText="true/false (optional)"
          style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>

<!-- Add this label above the new TextField -->
<Text fill="WHITE" layoutX="100.0" layoutY="390.0" strokeType="OUTSIDE" strokeWidth="0.0" 
      text="On Sale:" style="-fx-font-weight: bold;">
   <font>
      <Font size="20.0" />
   </font>
</Text>
   
   <!-- Buttons -->
   <Button fx:id="save" layoutX="400.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleAddFood" 
           prefHeight="40.0" prefWidth="120.0" text="SAVE" 
           style="-fx-background-radius: 20; -fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0, 0, 1);"/>
   
   <Button fx:id="backtoaddnewproducts" layoutX="150.0" layoutY="400.0" mnemonicParsing="false" onAction="#goBackToaddNewProduct" 
           prefHeight="40.0" prefWidth="120.0" text="Back" 
           style="-fx-background-radius: 20; -fx-background-color: #f8f8f8; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-border-color: #dddddd; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 2, 0, 0, 1);"/>
   
</AnchorPane>