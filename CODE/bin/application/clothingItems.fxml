<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="449.0" prefWidth="702.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.clothingItemsController">
   
   <!-- Orange-Green Gradient Background -->
   <Rectangle height="449.0" width="700.0">
      <fill>
         <LinearGradient endX="1" endY="1" startX="0" startY="0">
            <stops>
               <Stop color="#FFA500" offset="0.0" /> <!-- Orange -->
               <Stop color="#32CD32" offset="1.0" /> <!-- Green -->
            </stops>
         </LinearGradient>
      </fill>
   </Rectangle>
   
   <!-- Title -->
   <Text fill="WHITE" layoutX="93.0" layoutY="54.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0, 0, 1);" text="Clothing Items Inventory">
      <font>
         <Font size="44.0" />
      </font>
   </Text>
   
   <!-- Table with Rounded Corners -->
   <TableView layoutX="21.0" layoutY="75.0" prefHeight="300.0" prefWidth="660.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
      <columns>
         <TableColumn prefWidth="50.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10 0 0 0;" text="ID" />
         <TableColumn prefWidth="150.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Name" />
         <TableColumn prefWidth="80.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Price" />
         <TableColumn prefWidth="80.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Quantity" />
         <TableColumn prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Manufacturing Date" />
         <TableColumn prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Expiry Date" />
         <TableColumn prefWidth="80.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 0 10 0 0;" text="On Sale" />
      </columns>
      <style>
         -fx-table-cell-border-color: #e0e0e0;
      </style>
   </TableView>
   
   <!-- Rounded Back Button -->
   <Button layoutX="14.0" layoutY="396.0" mnemonicParsing="false" onAction="#backToAllProducts" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #c0c0c0; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 2, 0, 0, 1);" text="Back" />
   
</AnchorPane>
