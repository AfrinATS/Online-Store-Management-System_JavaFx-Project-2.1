<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/23.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.addClotheController">
   
   <!-- White Background with Shadow -->
   <Rectangle width="650.0" height="550.0" fill="WHITE" 
              style="-fx-effect: dropshadow(gaussian, #FF8C00, 10, 0, 0, 0);"/>
   
   <!-- Title -->
   <Text fill="#333333" layoutX="200.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Add New Clothing" style="-fx-font-weight: bold;">
      <font>
         <Font size="30.0" />
      </font>
   </Text>
   
   <!-- Form Labels (Left-Aligned) -->
   <Text fill="#333333" layoutX="100.0" layoutY="150.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="ID:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="#333333" layoutX="100.0" layoutY="190.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Name:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="#333333" layoutX="100.0" layoutY="230.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Category:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="#333333" layoutX="100.0" layoutY="270.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Size:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="#333333" layoutX="100.0" layoutY="310.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Color:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <Text fill="#333333" layoutX="100.0" layoutY="350.0" strokeType="OUTSIDE" strokeWidth="0.0" 
         text="Price:" style="-fx-font-weight: bold;">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   
   <!-- Rounded Text Fields with Orange Border -->
   <TextField fx:id="idField" layoutX="300.0" layoutY="130.0" prefWidth="300.0" 
              style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-radius: 5; -fx-border-color: #FF8C00; -fx-border-width: 1.5;"/>
   <TextField fx:id="nameField" layoutX="300.0" layoutY="170.0" prefWidth="300.0" 
              style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-radius: 5; -fx-border-color: #FF8C00; -fx-border-width: 1.5;"/>
   <TextField fx:id="categoryField" layoutX="300.0" layoutY="210.0" prefWidth="300.0" 
              style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-radius: 5; -fx-border-color: #FF8C00; -fx-border-width: 1.5;"/>
   <TextField fx:id="sizeField" layoutX="300.0" layoutY="250.0" prefWidth="300.0" 
              style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-radius: 5; -fx-border-color: #FF8C00; -fx-border-width: 1.5;"/>
   <TextField fx:id="colorField" layoutX="300.0" layoutY="290.0" prefWidth="300.0" 
              style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-radius: 5; -fx-border-color: #FF8C00; -fx-border-width: 1.5;"/>
   <TextField fx:id="priceField" layoutX="300.0" layoutY="330.0" prefWidth="300.0" 
              style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-radius: 5; -fx-border-color: #FF8C00; -fx-border-width: 1.5;"/>
   
   <!-- Buttons (Styled like addFood.fxml) -->
   <Button fx:id="saveButton" layoutX="400.0" layoutY="400.0" mnemonicParsing="false" 
           prefHeight="40.0" prefWidth="120.0" text="SAVE" 
           style="-fx-background-color: white; -fx-text-fill: #228B22; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-width: 2; -fx-border-color: #228B22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
   
   <Button fx:id="backButton" layoutX="150.0" layoutY="400.0" mnemonicParsing="false" 
           prefHeight="40.0" prefWidth="120.0" text="Back" 
           style="-fx-background-color: white; -fx-text-fill: #4169E1; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-width: 2; -fx-border-color: #4169E1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
</AnchorPane>